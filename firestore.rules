rules_version = '2';

// Meridian's only Firestore data is bugReportContacts: the private contact emails left with bug
// reports, written by the reportBug function through the Admin SDK, which these rules don't
// restrict. No browser may read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

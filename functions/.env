# Parameters for the reportBug function (src/index.ts), read on deploy and by the emulator.
# Committed: nothing here is secret. The GitHub token is a Secret Manager secret, not a param.
# Local overrides go in .env.local (gitignored), e.g. BUG_REPORT_REPO=you/sandbox.
BUG_REPORT_REPO=blueanvildesigns/meridian
# Off switch: set to false and run `firebase deploy --only functions` to answer 503 to everyone.
# Faster ways to stop it are in docs/manual-setup-bug-reporting.md, part 7.
BUG_REPORT_ENABLED=true
